MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority

# Google OAuth (custom flow; must match Google Cloud Console redirect URI exactly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# After OAuth callback, browser is redirected here; errors append ?error=… (path only, must start with /).
# On success, an httpOnly `session_id` cookie is also set (7-day session stored in MongoDB `sessions` collection).
OAUTH_SUCCESS_REDIRECT_PATH=/profile
